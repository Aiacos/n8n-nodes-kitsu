{
  "name": "n8n-nodes-kitsu",
  "version": "0.1.0",
  "description": "n8n community node for Kitsu (CGWire) — full REST API access for animation/VFX production management",
  "keywords": [
    "n8n-community-node-package",
    "kitsu",
    "cgwire",
    "zou",
    "animation",
    "vfx",
    "production"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Aiacos/n8n-nodes-kitsu",
  "author": {
    "name": "Aiacos",
    "url": "https://github.com/Aiacos"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aiacos/n8n-nodes-kitsu.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint",
    "prepublishOnly": "npm run build && npm run lint",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KitsuApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Kitsu/Kitsu.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@n8n/node-cli": "^0.23.0",
    "@types/node": "^18.19.130",
    "eslint": "^9.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {}
}
