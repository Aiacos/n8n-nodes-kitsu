{
  "name": "Kitsu — AI gestisce Task in Review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 4 }]
        }
      },
      "id": "trigger-schedule",
      "name": "Ogni 4 ore",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "getAll",
        "filters": {
          "project_id": "={{ $vars.KITSU_PROJECT_ID }}",
          "task_status_id": "={{ $vars.KITSU_STATUS_REVIEW_ID }}"
        }
      },
      "id": "kitsu-get-review-tasks",
      "name": "Kitsu: Task in Review",
      "type": "n8n-nodes-kitsu.kitsu",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "kitsuApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Kitsu API"
        }
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "tasks"
      },
      "id": "aggregate-tasks",
      "name": "Aggrega tutti i Task",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "agent": "toolsAgent",
        "promptType": "define",
        "text": "=Sei un supervisore di produzione VFX. Analizza i seguenti task in stato Review e per ognuno decidi:\n- Se ha una due_date scaduta → aggiorna la priorità a 3 (urgente)\n- Se non ha assignees → assegna alla persona con ID {{ $vars.KITSU_DEFAULT_SUPERVISOR_ID }}\n- Se è in Review da più di 7 giorni (controlla updated_at) → posta un commento di sollecito\n\nTask da analizzare:\n{{ JSON.stringify($json.tasks, null, 2) }}\n\nEsegui le azioni necessarie usando i tool disponibili. Alla fine riassumi cosa hai fatto.",
        "options": {
          "systemMessage": "Sei un assistente di produzione VFX. Hai accesso agli strumenti Kitsu per aggiornare task e postare commenti. Agisci in modo preciso e documentato."
        }
      },
      "id": "ai-agent",
      "name": "AI Agent: Supervisore Produzione",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [900, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "id": "openai-model",
      "name": "GPT-4o",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [900, 520],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "name": "aggiorna_task",
        "description": "Aggiorna un task Kitsu. Usa per cambiare priorità, stato, assignees, due_date.",
        "workflowId": "",
        "fields": {
          "values": [
            {
              "name": "task_id",
              "type": "string",
              "description": "UUID del task da aggiornare"
            },
            {
              "name": "priority",
              "type": "number",
              "description": "Priorità: 0=normale, 1=alta, 2=molto alta, 3=urgente"
            },
            {
              "name": "assignees",
              "type": "string",
              "description": "JSON array di UUID delle persone da assegnare"
            }
          ]
        }
      },
      "id": "tool-update-task",
      "name": "Tool: Aggiorna Task",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.2,
      "position": [680, 520]
    },
    {
      "parameters": {
        "name": "posta_commento",
        "description": "Posta un commento su un task Kitsu.",
        "workflowId": "",
        "fields": {
          "values": [
            {
              "name": "task_id",
              "type": "string",
              "description": "UUID del task"
            },
            {
              "name": "testo",
              "type": "string",
              "description": "Testo del commento da postare"
            }
          ]
        }
      },
      "id": "tool-post-comment",
      "name": "Tool: Posta Commento",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.2,
      "position": [1100, 520]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "update",
        "id": "={{ $json.task_id }}",
        "fields": {
          "priority": "={{ $json.priority }}",
          "assignees": "={{ $json.assignees }}"
        }
      },
      "id": "kitsu-update-task",
      "name": "Kitsu: Aggiorna Task (sub-call)",
      "type": "n8n-nodes-kitsu.kitsu",
      "typeVersion": 1,
      "position": [680, 720],
      "credentials": {
        "kitsuApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Kitsu API"
        }
      },
      "notes": "Chiamato internamente dal Tool aggiorna_task"
    },
    {
      "parameters": {
        "resource": "comment",
        "operation": "create",
        "taskId": "={{ $json.task_id }}",
        "text": "={{ $json.testo }}"
      },
      "id": "kitsu-post-comment",
      "name": "Kitsu: Posta Commento (sub-call)",
      "type": "n8n-nodes-kitsu.kitsu",
      "typeVersion": 1,
      "position": [1100, 720],
      "credentials": {
        "kitsuApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Kitsu API"
        }
      },
      "notes": "Chiamato internamente dal Tool posta_commento"
    },
    {
      "parameters": {
        "content": "## ✅ Riepilogo esecuzione AI\n{{ $json.output }}",
        "options": {}
      },
      "id": "note-output",
      "name": "Log output AI",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Ogni 4 ore": {
      "main": [[{ "node": "Kitsu: Task in Review", "type": "main", "index": 0 }]]
    },
    "Kitsu: Task in Review": {
      "main": [[{ "node": "Aggrega tutti i Task", "type": "main", "index": 0 }]]
    },
    "Aggrega tutti i Task": {
      "main": [[{ "node": "AI Agent: Supervisore Produzione", "type": "main", "index": 0 }]]
    },
    "AI Agent: Supervisore Produzione": {
      "main": [[{ "node": "Log output AI", "type": "main", "index": 0 }]]
    },
    "GPT-4o": {
      "ai_languageModel": [[{ "node": "AI Agent: Supervisore Produzione", "type": "ai_languageModel", "index": 0 }]]
    },
    "Tool: Aggiorna Task": {
      "ai_tool": [[{ "node": "AI Agent: Supervisore Produzione", "type": "ai_tool", "index": 0 }]]
    },
    "Tool: Posta Commento": {
      "ai_tool": [[{ "node": "AI Agent: Supervisore Produzione", "type": "ai_tool", "index": 1 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "versionId": "1",
  "triggerCount": 0,
  "tags": [{ "name": "kitsu" }, { "name": "ai" }, { "name": "automation" }]
}
